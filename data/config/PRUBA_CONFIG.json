{
  "simulation": {
    "time_step": 0.02,
    "duration": 120,
    "max_iterations": 1000,
    "enable_logging": true,
    "log_level": "INFO",
    "log_file": "logs/molab_web.log"
  },
  "physics": {
    "enable_gravity": true,
    "gravity_magnitude": 9.81,
    "enable_atmospheric_drag": true,
    "integration_tolerance": 1e-06,
    "integrator_type": "runge_kutta_4"
  },
  "plugins": [
    {
      "name": "Propulsion",
      "type": 1,
      "description": "Rocket/jet propulsion with fuel consumption and altitude compensation",
      "enabled": true,
      "parameters": {
        "sea_level_thrust": 50000,
        "specific_impulse_sl": 250,
        "engine_on": true,
        "throttle_setting": 0.8
      },
      "library_path": "/Users/johancastrillon/Documents/MoLab/build/lib/libpropulsion.dylib"
    }
  ],
  "output": {
    "enable_csv": true,
    "enable_json": false,
    "enable_binary": false,
    "output_interval": 1,
    "output_directory": "output"
  }
}