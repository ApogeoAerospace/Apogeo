{
    "simulation": {
        "time_step": 0.05,
        "duration": 180.0,
        "max_iterations": 3600,
        "logging_enabled": true,
        "log_level": "DEBUG"
    },
    "physics": {
        "gravity": 9.81,
        "drag_coefficient": 0.0,
        "integrator_type": "runge_kutta_4",
        "tolerance": 1e-7
    },
    "initial_state": {
        "position": [0.0, 0.0, 10000.0],
        "velocity": [50.0, 0.0, -100.0],
        "orientation": [0.0, 0.0, 0.0, 1.0],
        "angular_velocity": [0.0, 0.0, 0.0],
        "mass": 25000.0,
        "atmospheric_conditions": {
            "temperature": 250.0,
            "pressure": 26500.0,
            "density": 0.414,
            "wind_velocity": [20.0, 5.0, 0.0]
        }
    },
    "plugins": [
        {
            "name": "aerodynamics",
            "type": "PARALLEL_PHYSICS_CALCULATOR",
            "enabled": true,
            "parameters": {
                "reference_area": 80.0,
                "drag_coefficient": 1.2,
                "lift_coefficient": 0.3,
                "enable_drag": true,
                "enable_lift": true,
                "enable_compressibility": false,
                "grid_fins_area": 20.0,
                "parachute_area": 1200.0,
                "parachute_deploy_altitude": 3000.0,
                "parachute_drag_coefficient": 1.4
            }
        },
        {
            "name": "propulsion",
            "type": "PARALLEL_PHYSICS_CALCULATOR",
            "enabled": true,
            "parameters": {
                "sea_level_thrust": 845000.0,
                "specific_impulse_sl": 282.0,
                "specific_impulse_vac": 311.0,
                "engine_on": false,
                "throttle_setting": 0.0,
                "burn_time": 0.0,
                "fuel_mass_initial": 5000.0,
                "enable_altitude_compensation": true,
                "enable_thrust_vectoring": true,
                "landing_burn_start_altitude": 1500.0,
                "landing_burn_throttle": 0.6,
                "hover_slam_enabled": true
            }
        },
        {
            "name": "structures",
            "type": "SEQUENTIAL_STATE_MODIFIER",
            "enabled": true,
            "parameters": {
                "dry_mass": 20000.0,
                "enable_mass_tracking": true,
                "enable_inertia_calculation": true,
                "enable_structural_loads": true,
                "max_g_force": 6.0,
                "structural_integrity_factor": 1.5,
                "center_of_gravity_offset": [0.0, 0.0, -8.0],
                "landing_legs_deployed": true,
                "landing_legs_mass": 500.0
            }
        },
        {
            "name": "environment",
            "type": "SEQUENTIAL_STATE_MODIFIER",
            "enabled": true,
            "parameters": {
                "enable_atmospheric_model": true,
                "enable_wind_effects": true,
                "enable_gravity_variation": false,
                "enable_coriolis_effect": false,
                "earth_radius": 6371000.0,
                "launch_latitude": 28.5,
                "launch_longitude": -80.6,
                "landing_site_elevation": 0.0,
                "wind_speed_surface": 25.0,
                "wind_direction": 270.0,
                "turbulence_intensity": 0.2,
                "ground_effect_altitude": 100.0
            }
        }
    ],
    "output": {
        "format": "csv",
        "interval": 1,
        "directory": "results",
        "include_debug_info": true,
        "extended_telemetry": true
    }
}
