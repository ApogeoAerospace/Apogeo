{
  "simulation": {
    "time_step": 0.1,
    "duration": 10,
    "max_iterations": 1000,
    "enable_logging": true,
    "log_level": "INFO",
    "log_file": "logs/molab_web.log"
  },
  "physics": {
    "enable_gravity": true,
    "gravity_magnitude": 9.81,
    "enable_atmospheric_drag": false,
    "integration_tolerance": 1e-06,
    "integrator_type": "runge_kutta_4"
  },
  "plugins": [],
  "output": {
    "enable_csv": true,
    "enable_json": false,
    "enable_binary": false,
    "output_interval": 1,
    "output_directory": "output"
  },
  "initial_state_file": "D:\\molab\\data\\initial_state\\realistic_state.json"
}