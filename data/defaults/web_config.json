{
  "simulation": {
    "time_step": 0.01,
    "duration": 30,
    "max_iterations": 3000,
    "enable_logging": true,
    "log_level": "INFO",
    "log_file": "logs/apogeo_web.log"
  },
  "physics": {
    "enable_atmospheric_drag": false,
    "integration_tolerance": 1e-06,
    "integrator_type": "runge_kutta_4"
    }
  },
 "physics": {
    "enable_atmospheric_drag": false,
    "integration_tolerance": 1e-06,
    "integrator_type": "runge_kutta_4"
  },
  "plugins": [
    {
      "name": "example_plugin",
      "enabled": true,
      "config": {
        "apply_gravity": true,
        "gravity_accel": 9.81
      }
    }
  ],
  "output": {
    "enable_csv": true,
    "enable_json": false,
    "enable_binary": false,
    "output_interval": 1,
    "output_directory": "output"
  },
  "initial_state": {
    "position": [
      0,
      0,
      0
    ],
    "velocity": [
      120,
      0,
      120
    ],
    "mass": 1000
  }
}
