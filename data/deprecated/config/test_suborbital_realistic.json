{
    "simulation": {
        "time_step": 0.1,
        "duration": 300.0,
        "max_iterations": 3000,
        "logging_enabled": true,
        "log_level": "INFO"
    },
    "physics": {
        "gravity": 9.81,
        "drag_coefficient": 0.0,
        "integrator_type": "runge_kutta_4",
        "tolerance": 1e-6
    },
    "initial_state": {
        "position": [0.0, 0.0, 0.0],
        "velocity": [0.0, 0.0, 150.0],
        "orientation": [0.0, 0.0, 0.0, 1.0],
        "angular_velocity": [0.0, 0.0, 0.0],
        "mass": 50000.0,
        "atmospheric_conditions": {
            "temperature": 288.15,
            "pressure": 101325.0,
            "density": 1.225,
            "wind_velocity": [5.0, 0.0, 0.0]
        }
    },
    "plugins": [
        {
            "name": "aerodynamics",
            "library_path": "build/lib/libaerodynamics",
            "type": 1,
            "enabled": true,
            "parameters": {
                "reference_area": 50.0,
                "drag_coefficient": 0.3,
                "lift_coefficient": 0.1,
                "enable_drag": true,
                "enable_lift": true,
                "enable_compressibility": true,
                "mach_transition": 0.8,
                "supersonic_drag_multiplier": 2.5
            }
        },
        {
            "name": "propulsion",
            "library_path": "build/lib/libpropulsion",
            "type": 1, 
            "enabled": true,
            "parameters": {
                "sea_level_thrust": 750000.0,
                "specific_impulse_sl": 280.0,
                "specific_impulse_vac": 310.0,
                "engine_on": true,
                "throttle_setting": 1.0,
                "burn_time": 120.0,
                "fuel_mass_initial": 40000.0,
                "enable_altitude_compensation": true,
                "enable_thrust_vectoring": false
            }
        },
        {
            "name": "structures",
            "library_path": "build/lib/libstructures",
            "type": 1,
            "enabled": true,
            "parameters": {
                "dry_mass": 10000.0,
                "enable_mass_tracking": true,
                "enable_inertia_calculation": true,
                "enable_structural_loads": true,
                "max_g_force": 8.0,
                "structural_integrity_factor": 1.0,
                "center_of_gravity_offset": [0.0, 0.0, -2.0]
            }
        },
        {
            "name": "environment",
            "library_path": "build/lib/libenvironment",
            "type": 1,
            "enabled": true,
            "parameters": {
                "enable_atmospheric_model": true,
                "enable_wind_effects": true,
                "enable_gravity_variation": true,
                "enable_coriolis_effect": true,
                "earth_radius": 6371000.0,
                "launch_latitude": 28.5,
                "launch_longitude": -80.6,
                "wind_speed_surface": 10.0,
                "wind_direction": 90.0,
                "turbulence_intensity": 0.1
            }
        }
    ],
    "output": {
        "format": "csv",
        "interval": 1,
        "directory": "results",
        "include_debug_info": true,
        "extended_telemetry": true
    }
}
