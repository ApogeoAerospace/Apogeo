namespace state_vector;

// -----------------------------------------------------------------------
// Auxiliary Structures
// -----------------------------------------------------------------------

struct Vec3 { 
  x:float; 
  y:float; 
  z:float; 
}

struct Quaternion { 
  x:float; 
  y:float; 
  z:float; 
  w:float; 
}

struct InertiaTensor {
  ixx:float;
  iyy:float;
  izz:float;
  ixy:float;
  ixz:float;
  iyz:float;
}

struct EngineCmd {
  throttle:float;    // Thrust level
  tvc_angles:Vec3;   // Local engine thrust vectoring angles
}

// -----------------------------------------------------------------------
// Main Table
// -----------------------------------------------------------------------

table GeneralState {
  // -----------------------------------------------------------------------
  // 2.1. Vehicle State (Kinematics and Dynamics)
  // -----------------------------------------------------------------------
  
  sim_time:float;           // Current mission time
  dt:float;                 // Integrator time step

  position:Vec3;            // Inertial coordinates
  velocity:Vec3;            // Linear velocity vector
  
  orientation:Quaternion;   // Attitude
  angular_velocity:Vec3;    // Rotation rates (P, Q, R)

  total_mass:float;         // Instantaneous total mass
  cg_location:Vec3;         // Center of gravity location
  inertia_tensor:InertiaTensor; // Inertia tensor

  // Fuel mass in each tank
  propellant_masses:[float]; 

  // -----------------------------------------------------------------------
  // 2.2. Aerodynamic State (Air Data)
  // -----------------------------------------------------------------------

  mach_number:float;        // Mach number
  dynamic_pressure:float;   // Dynamic pressure

  angle_of_attack:float;    // Alpha
  sideslip_angle:float;     // Beta

  // -----------------------------------------------------------------------
  // 2.3. Environment and Control
  // -----------------------------------------------------------------------

  atm_density:float;        // Density
  atm_pressure:float;       // Static pressure
  atm_temperature:float;    // Temperature

  wind_velocity:Vec3;       // Atmospheric wind vector
  gravity:Vec3;             // Local gravity vector

  // Propulsion commands per engine
  // Engine list, each with its own throttle and TVC
  engines:[EngineCmd]; 

  // Control surface deflection
  // Vector for N surfaces
  surface_deflections:[float]; 
}

root_type GeneralState;
