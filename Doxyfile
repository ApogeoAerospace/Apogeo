# Doxyfile - Doxygen configuration for MoLab
# Generated for the MoLab Aerospace Simulator project
# Date: February 2026

#---------------------------------------------------------------------------
# Project Information
#---------------------------------------------------------------------------

PROJECT_NAME           = "MoLab Aerospace Simulator"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Modular aerospace simulator with plugin architecture"
PROJECT_LOGO           = 

# Output directory for generated documentation
OUTPUT_DIRECTORY       = docs/generated

# Create subdirectories for HTML, LaTeX, etc.
CREATE_SUBDIRS         = YES

#---------------------------------------------------------------------------
# Input Options
#---------------------------------------------------------------------------

# Directories and files to document
INPUT                  = src \
                         plugins \
                         tests \
                         README.md

# File extensions to process
FILE_PATTERNS          = *.cpp \
                         *.h \
                         *.hpp \
                         *.c \
                         *.fbs \
                         *.md

# Process subdirectories recursively
RECURSIVE              = YES

# Files and directories to exclude
EXCLUDE                = build \
                         vcpkg_installed \
                         .git

# Exclusion patterns
EXCLUDE_PATTERNS       = */build/* \
                         */.git/* \
                         */vcpkg_installed/*

# Use README.md as main page
USE_MDFILE_AS_MAINPAGE = README.md

# Map non-standard extensions for Doxygen parsing
EXTENSION_MAPPING      = fbs=C++

# Customized layout file
LAYOUT_FILE            = docs/doxygen_layout.xml

#---------------------------------------------------------------------------
# Build Options
#---------------------------------------------------------------------------

# Extract all elements (including undocumented)
EXTRACT_ALL            = YES

# Extract private members
EXTRACT_PRIVATE        = YES

# Extract static members
EXTRACT_STATIC         = YES

# Extract local members (function-scope variables)
EXTRACT_LOCAL_CLASSES  = YES

# Sort members alphabetically
SORT_MEMBER_DOCS       = YES

# Show include files
SHOW_INCLUDE_FILES     = YES

# Show namespaces
SHOW_NAMESPACES        = YES

#---------------------------------------------------------------------------
# Warning Options
#---------------------------------------------------------------------------

# Show warnings for undocumented elements
WARN_IF_UNDOCUMENTED   = YES

# Show warnings for invalid documentation format
WARN_IF_DOC_ERROR      = YES

# Warnings log file (empty = stderr)
WARN_LOGFILE           = docs/doxygen_warnings.log

#---------------------------------------------------------------------------
# HTML Options
#---------------------------------------------------------------------------

# Generate HTML documentation
GENERATE_HTML          = YES

# HTML output directory
HTML_OUTPUT            = html

# Navigation sidebar tree
GENERATE_TREEVIEW      = YES

# Color theme
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80

# Server-side search engine
SEARCHENGINE           = YES

# Client-side search (JavaScript)
SERVER_BASED_SEARCH    = NO

#---------------------------------------------------------------------------
# LaTeX/PDF Options
#---------------------------------------------------------------------------

# Do not generate LaTeX by default (enable if PDF is needed)
GENERATE_LATEX         = NO

#---------------------------------------------------------------------------
# Graph Options
#---------------------------------------------------------------------------

# Generate dependency graphs (requires Graphviz)
HAVE_DOT               = YES

# Class inheritance graphs
CLASS_GRAPH            = YES

# Class collaboration graphs
COLLABORATION_GRAPH    = YES

# Include dependency graphs
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES

# Function call graphs
CALL_GRAPH             = YES
CALLER_GRAPH           = YES

# Image format
DOT_IMAGE_FORMAT       = svg

# Use interactive SVG
INTERACTIVE_SVG        = YES

# Graphviz temporary path
DOT_PATH               = 

#---------------------------------------------------------------------------
# Preprocessor Options
#---------------------------------------------------------------------------

# Expand macros
ENABLE_PREPROCESSING   = YES

# Search include files
SEARCH_INCLUDES        = YES

# Include paths
INCLUDE_PATH           = src \
                         src/core \
                         src/api \
                         plugins

# Predefined macros
PREDEFINED             = PLUGIN_EXPORT= \
                         WIN32

#---------------------------------------------------------------------------
# Language Options
#---------------------------------------------------------------------------

# Input encoding
INPUT_ENCODING         = UTF-8

# Output language
OUTPUT_LANGUAGE        = English

# Auto-link language keywords
BUILTIN_STL_SUPPORT    = YES

#---------------------------------------------------------------------------
# Additional Options
#---------------------------------------------------------------------------

# Show all inherited members
INLINE_INHERITED_MEMB  = YES

# Group members by type
SORT_BRIEF_DOCS        = YES

# Show @todo tags
GENERATE_TODOLIST      = YES

# Show @bug tags
GENERATE_BUGLIST       = YES

# Show @deprecated tags
GENERATE_DEPRECATEDLIST = YES

# Maximum number of code lines in @code
MAX_INITIALIZER_LINES  = 30

# Hide standard-library implementation details
HIDE_UNDOC_RELATIONS   = NO

# Extract inline source documentation
INLINE_SOURCES         = YES

# Show line numbers in source code
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO

# Source code references
REFERENCES_LINK_SOURCE = YES
