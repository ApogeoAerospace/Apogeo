# Doxyfile - Configuración de Doxygen para MoLab
# Generado para el proyecto MoLab Aerospace Simulator
# Fecha: Febrero 2026

#---------------------------------------------------------------------------
# Información del Proyecto
#---------------------------------------------------------------------------

PROJECT_NAME           = "MoLab Aerospace Simulator"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Simulador aeroespacial modular con arquitectura de plugins"
PROJECT_LOGO           = 

# Directorio de salida para la documentación generada
OUTPUT_DIRECTORY       = docs/generated

# Crear subdirectorios para HTML, LaTeX, etc.
CREATE_SUBDIRS         = YES

#---------------------------------------------------------------------------
# Opciones de Entrada
#---------------------------------------------------------------------------

# Directorios y archivos a documentar
INPUT                  = src \
                         plugins \
                         tests \
                         README.md

# Extensiones de archivo a procesar
FILE_PATTERNS          = *.cpp \
                         *.h \
                         *.hpp \
                         *.c \
                         *.fbs \
                         *.md

# Procesar subdirectorios recursivamente
RECURSIVE              = YES

# Archivos y directorios a excluir
EXCLUDE                = build \
                         vcpkg_installed \
                         .git

# Patrones a excluir
EXCLUDE_PATTERNS       = */build/* \
                         */.git/* \
                         */vcpkg_installed/*

# Usar README.md como página principal
USE_MDFILE_AS_MAINPAGE = README.md

# Mapear extensiones no estándar para parseo de Doxygen
EXTENSION_MAPPING      = fbs=C++

# Layout personalizado para nombres de pestañas en español
LAYOUT_FILE            = docs/doxygen_layout.xml

#---------------------------------------------------------------------------
# Opciones de Build
#---------------------------------------------------------------------------

# Extraer todos los elementos (incluso sin documentar)
EXTRACT_ALL            = YES

# Extraer miembros privados
EXTRACT_PRIVATE        = YES

# Extraer miembros estáticos
EXTRACT_STATIC         = YES

# Extraer miembros locales (variables de función)
EXTRACT_LOCAL_CLASSES  = YES

# Ordenar miembros alfabéticamente
SORT_MEMBER_DOCS       = YES

# Mostrar archivos incluidos
SHOW_INCLUDE_FILES     = YES

# Mostrar namespaces
SHOW_NAMESPACES        = YES

#---------------------------------------------------------------------------
# Opciones de Warnings
#---------------------------------------------------------------------------

# Mostrar warnings para elementos sin documentar
WARN_IF_UNDOCUMENTED   = YES

# Mostrar warnings para formato incorrecto
WARN_IF_DOC_ERROR      = YES

# Archivo de log de warnings (vacío = stderr)
WARN_LOGFILE           = docs/doxygen_warnings.log

#---------------------------------------------------------------------------
# Opciones de HTML
#---------------------------------------------------------------------------

# Generar documentación HTML
GENERATE_HTML          = YES

# Directorio de salida HTML
HTML_OUTPUT            = html

# Barra lateral de navegación
GENERATE_TREEVIEW      = YES

# Tema de colores
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80

# Motor de búsqueda del lado del servidor
SEARCHENGINE           = YES

# Búsqueda del lado del cliente (JavaScript)
SERVER_BASED_SEARCH    = NO

#---------------------------------------------------------------------------
# Opciones de LaTeX/PDF
#---------------------------------------------------------------------------

# No generar LaTeX por defecto (activar si necesitas PDF)
GENERATE_LATEX         = NO

#---------------------------------------------------------------------------
# Opciones de Gráficos
#---------------------------------------------------------------------------

# Generar gráficos de dependencias (requiere Graphviz)
HAVE_DOT               = YES

# Gráficos de herencia de clases
CLASS_GRAPH            = YES

# Gráficos de colaboración entre clases
COLLABORATION_GRAPH    = YES

# Gráficos de dependencias de archivos include
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES

# Gráficos de llamadas a funciones
CALL_GRAPH             = YES
CALLER_GRAPH           = YES

# Formato de imagen
DOT_IMAGE_FORMAT       = svg

# Usar SVG interactivo
INTERACTIVE_SVG        = YES

# Carpeta temporal de Graphviz
DOT_PATH               = 

#---------------------------------------------------------------------------
# Opciones de Preprocesador
#---------------------------------------------------------------------------

# Expandir macros
ENABLE_PREPROCESSING   = YES

# Buscar archivos include
SEARCH_INCLUDES        = YES

# Rutas de includes
INCLUDE_PATH           = src \
                         src/core \
                         src/api \
                         plugins

# Macros predefinidas
PREDEFINED             = PLUGIN_EXPORT= \
                         WIN32

#---------------------------------------------------------------------------
# Opciones de Lenguaje
#---------------------------------------------------------------------------

# Codificación de entrada
INPUT_ENCODING         = UTF-8

# Idioma de salida
OUTPUT_LANGUAGE        = Spanish

# Auto-enlazar palabras clave del lenguaje
BUILTIN_STL_SUPPORT    = YES

#---------------------------------------------------------------------------
# Opciones Adicionales
#---------------------------------------------------------------------------

# Mostrar todos los miembros heredados
INLINE_INHERITED_MEMB  = YES

# Agrupar miembros por tipo
SORT_BRIEF_DOCS        = YES

# Mostrar etiquetas @todo
GENERATE_TODOLIST      = YES

# Mostrar etiquetas @bug
GENERATE_BUGLIST       = YES

# Mostrar etiquetas @deprecated
GENERATE_DEPRECATEDLIST = YES

# Número máximo de líneas de código en @code
MAX_INITIALIZER_LINES  = 30

# Ocultar detalles de implementación de librería estándar
HIDE_UNDOC_RELATIONS   = NO

# Extraer documentación de código
INLINE_SOURCES         = YES

# Mostrar números de línea en código fuente
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO

# Referencias a código fuente
REFERENCES_LINK_SOURCE = YES
